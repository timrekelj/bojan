{
  "name": "bojan-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/web/assets','dist/web/assets',{recursive:true})\"",
    "start": "node dist/index.js",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@opencode/client": "^2.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.17.3",
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
