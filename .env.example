# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
# Guild (server) the bot serves
GUILD_ID=
# Optional: Discord role id that may use the dashboard (Administrator permission always allowed)
ADMIN_ROLE_ID=

# Dashboard (OAuth redirect must be registered in the Discord app:
# Redirect URI = DASHBOARD_URL + /auth/callback)
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Storage
DATABASE_PATH=data/bot.db

# Optional: FreeStuff (freestuffbot.xyz) webhook as a third free-games source.
# Public key (base64) from the FreeStuff dashboard; leave empty to disable.
# Webhook URL to register there: DASHBOARD_URL + /webhooks/freestuff
FREESTUFF_PUBLIC_KEY=

# Self-building (OpenCode agent), optional. Admins @mention the bot with a feature request; the
# `opencode` compose service plans and builds it. Enable it in the dashboard. Leave
# OPENCODE_PASSWORD empty to disable (the agent container then just idles).
# The agent container receives only the variables below (not the Discord secrets above).
OPENCODE_URL=http://opencode:4096

# Shared secret between the bot and the agent (HTTP Basic auth, user "opencode").
# Generate with: openssl rand -hex 32
OPENCODE_PASSWORD=

# OpenCode Go API key (activates the opencode-go provider headlessly)
OPENCODE_API_KEY=

# Fine-grained GitHub token, restricted to this repository only:
# Contents: Read and write, Pull requests: Read and write (Metadata: read is implied).
GH_TOKEN=

# Repository the agent works in
REPO_URL=https://github.com/timrekelj/bojan.git

# Git commit author email (name is always bojan-bot)
GIT_EMAIL=bojan-bot@users.noreply.github.com
