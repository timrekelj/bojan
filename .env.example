# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
# Guild (server) the bot serves
GUILD_ID=
# Optional: Discord role id that may use the dashboard (Administrator permission always allowed)
ADMIN_ROLE_ID=

# Dashboard (OAuth redirect must be registered in the Discord app:
# Redirect URI = DASHBOARD_URL + /auth/callback)
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Storage
DATABASE_PATH=data/bot.db

# Optional: FreeStuff (freestuffbot.xyz) webhook as a third free-games source.
# Public key (base64) from the FreeStuff dashboard; leave empty to disable.
# Webhook URL to register there: DASHBOARD_URL + /webhooks/freestuff
FREESTUFF_PUBLIC_KEY=
